{
  "name": "turnip",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Miklós Mándoki",
    "email": "getturnip@protonmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "pnpm lint && tsc -b && pnpm test && pnpm generate-licences && vite build",
    "lint": "prettier . --write && eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "watch": "tsc -b -w",
    "generate-assets": "capacitor-assets generate --ios --android",
    "generate-licences": "license-checker-rseidelsohn --production --markdown --out ATTRIBUTIONS.md --direct 0 --excludePackages 'turnip'",
    "android": "vite build --mode qa && cap sync android && cd android && ./gradlew installQaDebug",
    "android:prod": "vite build --mode production && cap sync android && cd android && ./gradlew installProdDebug",
    "ios": "vite build --mode development && cap sync ios && cap run ios",
    "ios:prod": "pnpm build && cap sync ios && cap run ios"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.1"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "^4.2.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/toast": "^8.0.1",
    "@supabase/supabase-js": "^2.112.4",
    "capacitor-native-settings": "^8.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "emoji-regex-xs": "^2.0.1",
    "jeep-sqlite": "^2.8.0",
    "lucide-react": "^1.37.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "sql.js": "1.11.0"
    }
  }
}
